# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local wordt nooit gecommit (zie .gitignore).

# Wachtwoord voor /pepbackend (verplicht om de backend lokaal te gebruiken)
PEPBACKEND_PASSWORD=
# Gebruikersnaam voor /pepbackend (optioneel, standaard "pep")
PEPBACKEND_USERNAME=pep

# API-key voor de "Vertaal alle nieuwe content"-knop in de pepbackend
# (los van/aanvullend op een eventueel Claude-abonnement)
ANTHROPIC_API_KEY=
